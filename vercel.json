{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron-notify",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/sync-missions",
      "schedule": "0 * * * *"
    }
  ]
}
